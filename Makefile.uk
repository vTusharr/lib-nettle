################################################################################
# Hogweed code (public-key crypto: RSA / ECDSA / EdDSA / DSA), built only when
# CONFIG_LIBNETTLE_HOGWEED is set. Bignums come from the bundled mini-gmp.
################################################################################
LIBNETTLE_SRCS-$(CONFIG_LIBNETTLE_HOGWEED) += $(LIBNETTLE_DIR)/mini-gmp.c
