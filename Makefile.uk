################################################################################
# Nettle prepare
################################################################################
# Run ./configure. --enable-mini-gmp builds bignum support from source ; --disable-assembler keeps the
# build pure C and architecture-independent.
$(LIBNETTLE_DIR)/.configured: $(LIBNETTLE_BUILD)/.origin
	$(call verbose_cmd,CONFIG,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./configure --enable-mini-gmp --disable-assembler && touch $@ && cp config.h testsuite/)

# Expose headers under the canonical <nettle/...> include prefix via a
# self-referential symlink (consumers include <nettle/rsa.h>).
$(LIBNETTLE_DIR)/nettle: $(LIBNETTLE_DIR)/.configured
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ln -sfn . nettle)

# Host-built ECC table generator. eccdata.c #includes mini-gmp.c directly, so it
# is self-contained and built with the host compiler.
$(LIBNETTLE_DIR)/eccdata: $(LIBNETTLE_DIR)/.configured
	$(call verbose_cmd,HOSTCC,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && $(HOSTCC) -O eccdata.c -lm -o eccdata)

# Generated ECC curve tables (NUMB_BITS=64 for x86_64/arm64 mini-gmp limbs).
$(LIBNETTLE_DIR)/ecc-secp192r1.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata secp192r1 8 6 64 >$@T && mv $@T $@)
$(LIBNETTLE_DIR)/ecc-secp224r1.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata secp224r1 16 7 64 >$@T && mv $@T $@)
$(LIBNETTLE_DIR)/ecc-secp256r1.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata secp256r1 11 6 64 >$@T && mv $@T $@)
$(LIBNETTLE_DIR)/ecc-secp384r1.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata secp384r1 32 6 64 >$@T && mv $@T $@)
$(LIBNETTLE_DIR)/ecc-secp521r1.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata secp521r1 44 6 64 >$@T && mv $@T $@)
$(LIBNETTLE_DIR)/ecc-curve25519.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata curve25519 11 6 64 >$@T && mv $@T $@)
$(LIBNETTLE_DIR)/ecc-curve448.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata curve448 38 6 64 >$@T && mv $@T $@)
$(LIBNETTLE_DIR)/ecc-gost-gc256b.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata gost_gc256b 11 6 64 >$@T && mv $@T $@)
$(LIBNETTLE_DIR)/ecc-gost-gc512a.h: $(LIBNETTLE_DIR)/eccdata
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && ./eccdata gost_gc512a 43 6 64 >$@T && mv $@T $@)

LIBNETTLE_PREPARED_DEPS = \
	$(LIBNETTLE_DIR)/.configured \
	$(LIBNETTLE_DIR)/nettle

# Hogweed needs the eccdata-generated curve tables before any source compiles.
LIBNETTLE_PREPARED_DEPS-$(CONFIG_LIBNETTLE_HOGWEED) += \
	$(LIBNETTLE_DIR)/ecc-secp192r1.h \
	$(LIBNETTLE_DIR)/ecc-secp224r1.h \
	$(LIBNETTLE_DIR)/ecc-secp256r1.h \
	$(LIBNETTLE_DIR)/ecc-secp384r1.h \
	$(LIBNETTLE_DIR)/ecc-secp521r1.h \
	$(LIBNETTLE_DIR)/ecc-curve25519.h \
	$(LIBNETTLE_DIR)/ecc-curve448.h \
	$(LIBNETTLE_DIR)/ecc-gost-gc256b.h \
	$(LIBNETTLE_DIR)/ecc-gost-gc512a.h

$(LIBNETTLE_BUILD)/.prepared : $(LIBNETTLE_PREPARED_DEPS) $(LIBNETTLE_PREPARED_DEPS-y)
	$(call verbose_cmd,GEN,libnettle: $(notdir $@), cd $(LIBNETTLE_DIR) && touch $@)

UK_PREPARE += $(LIBNETTLE_BUILD)/.prepared
